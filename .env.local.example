# Authentication
# Root account — always works, independent of the Postgres-backed user store below.
ADMIN_USER=admin
ADMIN_PASS=your-secure-password-here
JWT_SECRET=generate-with-openssl-rand-base64-32

# Postgres (Neon) — additional admin users created via the Users page (lib/users.ts).
# The admin_users table is created automatically on first use.
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Redis (Upstash) — optional response caching (lib/cache.ts). Cache reads/writes
# degrade gracefully when unset, so this is not required for the app to run.
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token

# WordPress Integration
WP_BASE_URL=https://whholidays.com
WP_USERNAME=your-wp-username
WP_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx

# Feature Flags
# Set to "true" to use mock data instead of live WP API
USE_MOCK_DATA=true
